{{ define "content" }}
<div class="row">
  <div class="span12">
    <h2>Reconciliation - {{.bankAccount}}</h2>

    {{ range .sections }}
    {{ $cur := .Statement.Currency }}
    {{ $sum := .Summary }}
    <div class="reconcile-section">
      <h3>
        {{ if eq $cur "US$" }}Dollars{{ else }}Pesos{{ end }} ({{$cur}})
        <small>{{$sum.StartDate.Format "2006-01-02"}} &rarr; {{$sum.EndDate.Format "2006-01-02"}}</small>
        {{ if $sum.Reconciled }}
          <span class="label label-success">Reconciled</span>
        {{ else }}
          <span class="label label-important">Off by {{money $sum.Difference $cur}}</span>
        {{ end }}
      </h3>

      <table class="table table-condensed reconcile-summary">
        <tbody>
          <tr>
            <td>{{$sum.StatementLabel}}{{ if $sum.StatementNote }}<br><small class="muted">{{$sum.StatementNote}}</small>{{ end }}</td>
            <td class="num">{{money $sum.StatementAmount $cur}}</td>
          </tr>
          <tr>
            <td>{{$sum.LedgerLabel}}</td>
            <td class="num">{{money $sum.LedgerAmount $cur}}</td>
          </tr>
          <tr class="total">
            <td>Difference <small class="muted">(ledger &minus; statement)</small></td>
            <td class="num">{{money $sum.Difference $cur}}</td>
          </tr>
          {{ if not $sum.Reconciled }}
            {{ range $sum.Explained }}
            <tr class="explained">
              <td>{{.Label}} ({{.Count}})</td>
              <td class="num">{{money .Amount $cur}}</td>
            </tr>
            {{ end }}
            <tr class="total {{ if $sum.Explainable }}ok{{ else }}bad{{ end }}">
              <td>
                Unexplained
                {{ if $sum.Explainable }}
                  <br><small>Fixing the items below will reconcile this statement.</small>
                {{ else }}
                  <br><small>Something outside this period differs too, e.g. an earlier statement that didn't reconcile.</small>
                {{ end }}
              </td>
              <td class="num">{{money $sum.Unexplained $cur}}</td>
            </tr>
          {{ end }}
        </tbody>
      </table>

      {{ if .Result.UnmatchedLedger }}
      <h4>Ledger entries not on the statement ({{len .Result.UnmatchedLedger}})</h4>
      <table class="table table-condensed table-striped">
        <tbody>
          {{ range .Result.UnmatchedLedger }}
          <tr class="error">
            <td class="date">{{.Date.Format "2006-01-02"}}</td>
            <td>{{.Description}}</td>
            <td class="num">{{money .Amount $cur}}</td>
          </tr>
          {{ end }}
        </tbody>
      </table>
      {{ end }}

      {{ if .Result.BoundaryLedger }}
      <h4>Ledger entries near the period edges ({{len .Result.BoundaryLedger}}) <small>not on this statement; usually on the previous or next one</small></h4>
      <table class="table table-condensed">
        <tbody>
          {{ range .Result.BoundaryLedger }}
          <tr class="muted">
            <td class="date">{{.Date.Format "2006-01-02"}}</td>
            <td>{{.Description}}</td>
            <td class="num">{{money .Amount $cur}}</td>
          </tr>
          {{ end }}
        </tbody>
      </table>
      {{ end }}

      <details {{ if .Result.UnmatchedBank }}open{{ end }}>
        <summary>
          <strong>Statement transactions</strong>
          &mdash; {{len .Result.AllBankTransactions}}, {{len .Result.Matches}} matched{{ if .Result.UnmatchedBank }}, <span class="text-warning">{{len .Result.UnmatchedBank}} missing from ledger</span>{{ end }}
        </summary>
        <table class="table table-condensed">
          <tbody>
            {{ range .Result.AllBankTransactions }}
            <tr class="{{ if not .Matched }}warning{{ end }}">
              <td class="date">{{.Transaction.Date.Format "2006-01-02"}}</td>
              <td>
                {{.Transaction.Description}}
                {{ if .Transaction.Reference }}<small class="muted">{{.Transaction.Reference}}</small>{{ end }}
              </td>
              <td class="num">{{money (sub .Transaction.Credit .Transaction.Debit) $cur}}</td>
              <td>
                {{ if not .Matched }}
                  <span class="label label-warning">Not in ledger</span>
                {{ else if eq .MatchType "exact" }}
                  <span class="label label-success">Matched</span>
                {{ else }}
                  <span class="label label-success" title="Ledger date {{.LedgerTransaction.Date.Format "2006-01-02"}}">Matched &plusmn;date</span>
                {{ end }}
              </td>
            </tr>
            {{ end }}
          </tbody>
        </table>
      </details>
    </div>
    {{ end }}

    {{ if .suggestedEntries }}
    <div class="well">
      <h4>Suggested Ledger Entries</h4>
      <p>Edit and copy these entries to add the statement items missing from the ledger:</p>
      <textarea class="edit full-file suggested-entries">{{ range .suggestedEntries }}{{.}}
{{ end }}</textarea>
      <button class="btn btn-small" onclick="copyToClipboard()">Copy to Clipboard</button>
    </div>
    {{ end }}

    <hr>
    <a href="{{.root}}/{{.ledger}}/reconcile" class="btn">Reconcile Another Statement</a>
    <a href="{{.root}}/{{.ledger}}" class="btn btn-primary">Back to Ledger</a>
  </div>
</div>

<script>
function copyToClipboard() {
  var ta = document.querySelector('textarea.suggested-entries');
  var cm = ta && $(ta).data('cm');
  var text = cm ? cm.getValue() : (ta ? ta.value : '');
  navigator.clipboard.writeText(text).then(function() {
    alert('Copied to clipboard!');
  }, function(err) {
    alert('Failed to copy: ' + err);
  });
}
</script>
{{ end }}
